--- !u!114 &1096927241
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1096927239}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aa2de124ca4bb964e9e420e579f488d7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bubblePrefab: {fileID: 5736675483342888346, guid: d5fba6b5ddadac745a37369aa2309a1d, type: 3}
  bubbleSpawnPoint: {fileID: 1690405897}
  allEndings:
  - endingSceneName: EndingPerfect
    dialogLines:
    - "\u201CKeputusanmu\u2026 sempurna. Tidak ada cela.\u201D"
    - "\u201CJarang ada hakim yang dapat menilai seakurat itu.\u201D"
    - "\u201CKau mengingatkanku bahwa harapan belum sepenuhnya mati.\u201D"
    - "\u201CAlam membutuhkan sedikit keadilan seperti ini.\u201D"
    - "\u201CTeruskan. Jangan biarkan integritasmu membusuk.\u201D"
    - "\u201CSampai kita bertemu lagi\u2026 hakim yang adil!.\u201D"
    isHappyMood: 1
  - endingSceneName: 'EndingGood '
    dialogLines:
    - "\u201CHasil penilaianmu cukup memuaskan.\u201D"
    - "\u201CBeberapa keputusan hampir meleset, tapi masih dapat diterima.\u201D"
    - "\u201CTidak buruk\u2026 untuk penghakiman pada levelmu.\u201D"
    - "\u201CTerus asah nuranimu. Alam ini tidak murah hati.\u201D"
    - "\u201CKesalahan kecilmu tidak fatal, tapi ingat\u2026 batasnya tipis.\u201D"
    - "\u201CPergilah. Perbaiki sisanya. Kita akan bertemu lagi.\u201D"
    isHappyMood: 1
  - endingSceneName: EndingBad
    dialogLines:
    - "\u201CPenilaianmu\u2026 mengecewakan.\u201D"
    - "\u201CKau memperlakukan nasib orang lain seperti permainan.\u201D"
    - "\u201CSatu kesalahan mungkin bisa dimaafkan. Tapi ini\u2026 terlalu banyak.\u201D"
    - "\u201CKau tidak layak memegang keputusan sebesar ini.\u201D"
    - "\u201CAku heran bagaimana kau bisa merasa puas dengan hasil seburuk itu.\u201D"
    - "\u201CPergi. Sebelum aku kehilangan sisa kesabaran terakhirku.\u201D"
    isHappyMood: 0
  - endingSceneName: EndingVeryBad
    dialogLines:
    - "\u201CKau telah menghancurkan segalanya.\u201D"
    - "\u201CSetiap keputusanmu\u2026 busuk dan gegabah.\u201D"
    - "\u201CJika ini bukan dunia roh, kau sudah dibuang ke kegelapan permanen.\u201D"
    - "\u201CKau bukan seorang hakim. Kau ancaman.\u201D"
    - "\u201CAku bahkan muak mengingat penilaianmu.\u201D"
    - "\u201CKeluar dari hadapanku. Jangan pernah kembali membawa kebodohan seperti
      ini.\u201D"
